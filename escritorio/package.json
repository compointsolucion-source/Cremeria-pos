{
  "name": "compoint-punto-escritorio",
  "productName": "Compoint Punto",
  "version": "1.0.0",
  "description": "Compoint Punto para Windows: abre el sistema en su propia ventana, arranca con Windows e incluye el intermediario de impresión por red.",
  "author": "Compoint, punto de soluciones",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "node scripts/construir.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "mx.com.compoint.punto",
    "productName": "Compoint Punto",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "config-cliente.json",
        "to": "config-cliente.json"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Compoint Punto",
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "artifactName": "Instalar-CompointPunto-${env.CLIENTE_ARCHIVO}.${ext}"
  }
}