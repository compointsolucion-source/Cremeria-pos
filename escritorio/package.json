{
  "name": "compoint-punto-escritorio",
  "productName": "Compoint Punto",
  "version": "1.0.0",
  "description": "Compoint Punto para Windows: abre el sistema en su propia ventana, arranca con Windows e incluye el intermediario de impresión por red.",
  "author": "Compoint, punto de soluciones",
  "main": "src/main.js",
  "scripts": {
    "start": "node scripts/preparar-servidor.js && electron .",
    "build": "node scripts/construir.js",
    "preparar": "node scripts/preparar-servidor.js",
    "test": "node --test",
    "empaquetar": "node scripts/empaquetar-instalador.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "embedded-postgres": "17.10.0-beta.17",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.12.0",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "mx.com.compoint.punto",
    "productName": "Compoint Punto",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "servidor/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "config-cliente.json",
        "to": "config-cliente.json"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "runAfterFinish": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Compoint Punto",
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerSidebar": "build/instalador-lateral.bmp",
      "uninstallerSidebar": "build/instalador-lateral.bmp",
      "language": "3082"
    },
    "artifactName": "Payload-CompointPunto.${ext}",
    "asar": false
  }
}
